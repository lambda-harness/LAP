{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lambda-harness/LAP/schemas/package-signature.schema.json",
  "title": "LAP Package Signature Sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lap",
    "algorithm",
    "key_id",
    "agent_id",
    "version",
    "package_sha256",
    "signature"
  ],
  "properties": {
    "lap": { "const": "0.1" },
    "algorithm": { "const": "ed25519" },
    "key_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,127}$"
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "package_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
