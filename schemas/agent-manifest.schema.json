{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lambda-harness/LAP/schemas/agent-manifest.schema.json",
  "title": "LAP Agent Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lap",
    "id",
    "display_name",
    "version",
    "transport",
    "capabilities"
  ],
  "properties": {
    "lap": {
      "const": "0.1"
    },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+$"
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 6,
        "maxLength": 160,
        "pattern": "^[a-z][a-z0-9-]{1,63}/[0-9]+\\.[0-9]+$"
      },
      "description": "Optional package-declared profile contracts. A Host must still negotiate a profile before a profile-owned run."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "transport": {
      "oneOf": [
        { "$ref": "#/$defs/localTransport" },
        { "$ref": "#/$defs/a2aTransport" },
        { "$ref": "#/$defs/nativeTransport" }
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requested": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        }
      }
    },
    "health_check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 300000 },
        "shutdown_timeout_ms": { "type": "integer", "minimum": 100, "maximum": 300000 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "required": ["sha256"] },
          "then": { "required": ["path"] }
        },
        {
          "if": { "required": ["path"] },
          "then": { "required": ["sha256"] }
        }
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "publisher": { "type": "string", "maxLength": 240 }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z0-9-]+)+$"
      },
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["profiles"],
        "properties": {
          "transport": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "const": "lap-local" }
            }
          }
        }
      },
      "then": {
        "properties": {
          "profiles": {
            "contains": { "const": "lap-local/0.1" }
          }
        }
      }
    }
  ],
  "$defs": {
    "localTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "command"],
      "properties": {
        "kind": { "const": "lap-local" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
        },
        "working_directory": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "a2aTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "agent_card_url"],
      "properties": {
        "kind": { "const": "a2a" },
        "agent_card_url": { "type": "string", "format": "uri" },
        "input_artifact_transfer": {
          "const": "inline",
          "description": "Opt in to the optional lap-a2a-inline-inputs/0.2 profile. The Host remains the admission authority."
        }
      }
    },
    "nativeTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "adapter"],
      "properties": {
        "kind": { "const": "native" },
        "adapter": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,127}$"
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "input_schema": {
          "type": "object",
          "description": "Self-contained JSON Schema Draft 2020-12 capability input contract; see SPEC.md section 5.1."
        },
        "output_schema": {
          "type": "object",
          "description": "Self-contained JSON Schema Draft 2020-12 capability output contract; see SPEC.md section 5.1."
        },
        "artifact_media_types": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 160 }
        },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    }
  }
}
