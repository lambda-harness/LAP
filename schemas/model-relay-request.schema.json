{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lambda-harness/LAP/schemas/model-relay-request.schema.json",
  "title": "LAP Model Relay Request Payload (Draft)",
  "type": "object",
  "additionalProperties": false,
  "required": ["route", "input", "max_output_tokens"],
  "properties": {
    "route": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,127}$"
    },
    "input": { "type": "object" },
    "max_output_tokens": { "type": "integer", "minimum": 1 }
  }
}
