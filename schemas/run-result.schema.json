{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lambda-harness/LAP/schemas/run-result.schema.json",
  "title": "LAP Run Result Payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary"],
  "properties": {
    "status": {
      "enum": ["succeeded", "failed", "cancelled", "timed_out"]
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "output": {},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "media_type"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 240 },
          "name": { "type": "string", "minLength": 1, "maxLength": 240 },
          "media_type": { "type": "string", "minLength": 1, "maxLength": 160 },
          "uri": { "type": "string", "format": "uri" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "delivery": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["download", "reference", "inline"]},
              "required": {"type": "boolean"},
              "disposition": {"enum": ["attachment", "inline"]},
              "scope": {"enum": ["run", "session", "tenant"]},
              "expires_at": {"type": "string"},
              "semantic": {"type": "object", "additionalProperties": false,
                "properties": {"role": {"enum": ["intermediate", "preview", "final_result", "error_report"]}, "title": {"type": "string", "maxLength": 400}, "description": {"type": "string", "maxLength": 400}, "source_count": {"type": "integer", "minimum": 0}}}
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^LAP-[1-5][0-9]{2}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "retryable": { "type": "boolean" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "succeeded" } } },
      "then": { "not": { "required": ["error"] } }
    },
    {
      "if": {
        "properties": {
          "status": { "enum": ["failed", "cancelled", "timed_out"] }
        }
      },
      "then": { "required": ["error"] }
    }
  ]
}
