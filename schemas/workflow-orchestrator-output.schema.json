{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lambda-harness/LAP/schemas/workflow-orchestrator-output.schema.json",
  "title": "LAP Workflow Orchestrator Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["dispatch"],
  "properties": {
    "dispatch": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/proposal" }
    }
  },
  "$defs": {
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_id", "capability", "input"],
      "properties": {
        "agent_id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
        "capability": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$" },
        "input": {},
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_output_tokens"],
          "properties": {
            "max_output_tokens": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
